@{
    ViewData["Title"] = "Dashboard";
}

<div class="container mt-4">
    <h2 class="mb-4">Dashboard — Stock Informatique</h2>

    <!-- Cartes statistiques -->
    <div class="row mb-4">
        <div class="col-md-3">
            <div class="card text-white bg-primary shadow">
                <div class="card-body">
                    <h6 class="card-title">Total Produits</h6>
                    <h2>@ViewBag.TotalProduits</h2>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card text-white bg-success shadow">
                <div class="card-body">
                    <h6 class="card-title">Valeur du Stock</h6>
                    <h2>@(((decimal)ViewBag.ValeurStock).ToString("C"))</h2>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card text-white bg-danger shadow">
                <div class="card-body">
                    <h6 class="card-title">Alertes Rupture</h6>
                    <h2>@ViewBag.AlertesRupture</h2>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card text-white bg-info shadow">
                <div class="card-body">
                    <h6 class="card-title">Catégories</h6>
                    <h2>@ViewBag.TotalCategories</h2>
                </div>
            </div>
        </div>
    </div>

    <div class="row">
        <!-- Produits en alerte -->
        <div class="col-md-6">
            <div class="card shadow mb-4">
                <div class="card-header bg-danger text-white">
                    Produits en rupture de stock
                </div>
                <div class="card-body p-0">
                    <table class="table table-hover mb-0">
                        <thead>
                            <tr>
                                <th>Produit</th>
                                <th>Catégorie</th>
                                <th>Quantité</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var p in ViewBag.ProduitsEnAlerte)
                            {
                                <tr class="table-danger">
                                    <td>@p.Nom</td>
                                    <td>@p.Categorie</td>
                                    <td><strong>@p.Quantite</strong></td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>

        <!-- Stock par catégorie -->
        <div class="col-md-6">
            <div class="card shadow mb-4">
                <div class="card-header bg-primary text-white">
                    Stock par catégorie
                </div>
                <div class="card-body p-0">
                    <table class="table table-hover mb-0">
                        <thead>
                            <tr>
                                <th>Catégorie</th>
                                <th>Produits</th>
                                <th>Valeur</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var c in ViewBag.ProduitsParCategorie)
                            {
                                <tr>
                                    <td>@c.Categorie</td>
                                    <td>@c.Count</td>
                                    <td>@(((decimal)c.Valeur).ToString("C"))</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>
