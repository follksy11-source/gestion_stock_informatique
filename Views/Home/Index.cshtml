@{
    ViewData["Title"] = "Accueil";
}

<div class="container mt-5">
    <div class="text-center mb-5">
        <h1 class="display-5 fw-bold text-primary">
            <i class="bi bi-box-seam me-2"></i>StockInfo
        </h1>
        <p class="lead text-muted">Plateforme de gestion de stock informatique</p>

        @if (User.Identity!.IsAuthenticated)
        {
            <a asp-controller="Home" asp-action="Dashboard" class="btn btn-primary btn-lg me-2">
                <i class="bi bi-speedometer2 me-1"></i>Voir le Dashboard
            </a>
            <a asp-controller="Produit" asp-action="Index" class="btn btn-outline-primary btn-lg">
                <i class="bi bi-laptop me-1"></i>Gérer les produits
            </a>
        }
        else
        {
            <a asp-controller="Account" asp-action="Login" class="btn btn-primary btn-lg me-2">
                <i class="bi bi-box-arrow-in-right me-1"></i>Se connecter
            </a>
            <a asp-controller="Account" asp-action="Register" class="btn btn-outline-primary btn-lg">
                <i class="bi bi-person-plus me-1"></i>Créer un compte
            </a>
        }
    </div>

    <div class="row text-center">
        <div class="col-md-4">
            <div class="card shadow p-4 mb-4">
                <i class="bi bi-shield-lock text-primary" style="font-size:2.5rem"></i>
                <h5 class="mt-3">Sécurisé</h5>
                <p class="text-muted">Authentification par cookies et JWT, gestion des rôles et policies.</p>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card shadow p-4 mb-4">
                <i class="bi bi-graph-up text-success" style="font-size:2.5rem"></i>
                <h5 class="mt-3">Suivi en temps réel</h5>
                <p class="text-muted">Dashboard avec alertes de rupture et valeur totale du stock.</p>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card shadow p-4 mb-4">
                <i class="bi bi-people text-info" style="font-size:2.5rem"></i>
                <h5 class="mt-3">Multi-rôles</h5>
                <p class="text-muted">Admin, Gestionnaire et Vendeur avec des accès différenciés.</p>
            </div>
        </div>
    </div>
</div>
