@model SecureApp.Models.RegisterViewModel
@{
    ViewData["Title"] = "Inscription";
}

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-5">
            <div class="card shadow-lg border-0 rounded-4">
                <div class="card-body p-5">
                    <div class="text-center mb-4">
                        <i class="bi bi-person-plus text-primary" style="font-size: 2.5rem"></i>
                        <h3 class="fw-bold mt-2">Creer un compte</h3>
                        <p class="text-muted">Rejoignez la plateforme StockInfo</p>
                    </div>
                    <form method="post">
                        <div asp-validation-summary="All" class="alert alert-danger py-2"></div>
                        <div class="mb-3">
                            <label asp-for="Email" class="form-label fw-semibold">Email</label>
                            <input asp-for="Email" class="form-control form-control-lg rounded-3" placeholder="exemple@email.com" />
                            <span asp-validation-for="Email" class="text-danger small"></span>
                        </div>
                        <div class="mb-3">
                            <label asp-for="Password" class="form-label fw-semibold">Mot de passe</label>
                            <input asp-for="Password" type="password" class="form-control form-control-lg rounded-3" placeholder="........" />
                            <span asp-validation-for="Password" class="text-danger small"></span>
                        </div>
                        <div class="mb-4">
                            <label asp-for="ConfirmPassword" class="form-label fw-semibold">Confirmer le mot de passe</label>
                            <input asp-for="ConfirmPassword" type="password" class="form-control form-control-lg rounded-3" placeholder="........" />
                            <span asp-validation-for="ConfirmPassword" class="text-danger small"></span>
                        </div>
                        <div class="d-grid">
                            <button type="submit" class="btn btn-primary btn-lg rounded-3">Creer mon compte</button>
                        </div>
                    </form>
                    <hr class="my-4">
                    <div class="text-center">
                        <p class="text-muted mb-0">Deja un compte ?
                            <a asp-controller="Account" asp-action="Login" class="text-primary fw-semibold">Se connecter</a>
                        </p>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
